PORT=3080
SESSION_TIMEOUT_MINUTES=10
EXECUTION_TIMEOUT_MS=30000
MAX_FILE_SIZE_BYTES=10485760
MAX_FILES_PER_REQUEST=10
RATE_LIMIT_REQUESTS_PER_MIN=10
MAX_SESSIONS=20
MAX_OUTPUT_FILES=100
MAX_OUTPUT_BYTE_SIZE=10485760
# Number of concurrent Pyodide worker init slots (prevents OOM on burst)
MAX_CONCURRENT_INITS=2

# Number of trusted reverse proxies in front of this service.
# 0 = ignore X-Forwarded-For, use direct connection IP only.
TRUSTED_PROXY_COUNT=0

LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
NODE_ENV_PRODUCTION=false
